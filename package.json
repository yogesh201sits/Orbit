{
  "name": "orbit",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "bun test packages",
    "test:integration": "bun test tests/integration",
    "test:all": "bun test",
    "test:watch": "bun test --watch",
    "typecheck": "tsc --noEmit",
    "db:generate": "bun run --cwd packages/storage db:generate",
    "db:migrate:create": "bun run --cwd packages/storage db:migrate:create",
    "db:migrate:dev": "bun run --cwd packages/storage db:migrate:dev",
    "db:migrate:deploy": "bun run --cwd packages/storage db:migrate:deploy",
    "db:migrate:status": "bun run --cwd packages/storage db:migrate:status",
    "db:migrate:reset": "bun run --cwd packages/storage db:migrate:reset",
    "db:push": "bun run --cwd packages/storage db:push",
    "db:studio": "bun run --cwd packages/storage db:studio",
    "clean": "rm -rf node_modules"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "latest"
  }
}
